<Window
    x:Class="SecretMoney.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SecretMoney"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SecretMoney"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="SecretMoney">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="32,8,32,32" Spacing="12" MaxWidth="960" HorizontalAlignment="Left">
                <TextBlock TextWrapping="Wrap"
                           Text="Turns the newest SecretBeans period into one QIF file per Managing Your Money account. Nothing is written until step 6." />

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="1. Where things are" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="hledger.exe" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HledgerPathText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Choose…" Click="ChooseHledger_Click" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="SecretBeans ledger folder" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LedgerFolderText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Choose…" Click="ChooseLedgerFolder_Click" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="QIF folder (MYM's D: drive)" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="QifFolderText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Choose…" Click="ChooseQifFolder_Click" />
                </Grid>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="2. Read SecretBeans" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ReadButton" Content="Read the newest period" Click="Read_Click" />
                    <TextBlock x:Name="PeriodText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="3. Accounts" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Tick the accounts to export. File names are up to 8 of A-Z, 0-9, _ and -. Unticking an account forgets its last export date." />
                <ItemsControl x:Name="AccountList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AccountRow">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind Chosen, Mode=TwoWay}" MinWidth="0" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind HledgerAccount}" TextTrimming="CharacterEllipsis" />
                                <TextBox Grid.Column="2" MaxLength="8" Text="{x:Bind FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="3" SelectedIndex="{x:Bind TypeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Bank" />
                                    <ComboBoxItem Content="Charge" />
                                </ComboBox>
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Opacity="0.8" Text="{x:Bind LastExportedText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="4. Category names" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="The MYM category for each SecretBeans category: up to 20 characters, no colon. Transfers between your accounts are always Transfer." />
                <ItemsControl x:Name="CategoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:CategoryRow">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind HledgerAccount}" TextTrimming="CharacterEllipsis" />
                                <TextBox Grid.Column="1" MaxLength="20" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="5. Dates" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CalendarDatePicker x:Name="StartDate" Header="First export starts on" />
                    <CalendarDatePicker x:Name="EndDate" Header="Export up to and including" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="The start date is used only for accounts never exported; the others start the day after their last export. Choose a last date your downloads are complete for: anything dated on or before it that arrives later is not exported." />

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="6. Check and write" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CheckButton" Content="Check" Click="Check_Click" />
                    <Button x:Name="WriteButton" Content="Write QIF files" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Write_Click" />
                </StackPanel>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
